{
  "name": "jazl-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jazl+ API: мини апп пен мекеме бөлімінің бэкенді (Cloud Run). Түбірдегі бот кодынан бөлек.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seed:build": "tsx scripts/build-seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@hono/node-server": "^2.1.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

---
// Футер (Figma Footer/Rich 10:651; мобиль Footer 30:816). Figma-да күндізгі режимге бекітілген: түнде де осындай.
import type { Dict } from "../i18n/kk";
import { BOT_URL, COMPANY, isBlank } from "../config";
import { href, otherLang, type PageKey } from "../routes";
import Icon from "./Icon.astro";
import PayLogos from "./PayLogos.astro";
import Qr from "./Qr.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const L = t.lang;
const ru = L === "ru";
const f = t.footer;
const cols: [string, PageKey[]][] = [
  [f.cols.clients, ["offers", "how", "buy", "places", "gift", "faq"]],
  [f.cols.venues, ["terms", "apply", "cabinet"]],
  [f.cols.company, ["about"]],
  [f.cols.docs, ["offer", "privacy", "refund", "use", "venueContract", "payment", "security", "personal", "service"]],
];
const path = Astro.url.pathname;
---
<footer class="wrap foot">
  <div class="day box">
    <ul class="badges">
      {f.badges.map((b) => (
        <li>
          <span class="ic"><Icon name={b.icon} size={18} /></span>
          <span><b class="full">{b.t}</b><b class="short">{b.short}</b><span class="d">{b.d}</span></span>
        </li>
      ))}
    </ul>

    <div class="mid">
      <div class="brand">
        <a class="logo" href={href(L, "home")}>medeo</a>
        <p class="full">{f.about}</p>
        <p class="short">{f.aboutShort}</p>
        <a class="tg" href={BOT_URL}>
          <Qr url={BOT_URL} size={48} label={f.tgSub} />
          <span><b>{f.tgTitle}</b><span>{f.tgSub}</span></span>
        </a>
      </div>
      <div class="cols">
      {cols.map(([title, keys]) => (
        <div class="col">
          <h2>{title}</h2>
          <ul>
            {keys.map((k) => {
              const [full, short] = f.links[k as keyof typeof f.links];
              return <li class:list={[!short && "desk"]}><a href={href(L, k)}><span class="full">{full}</span><span class="short">{short}</span></a></li>;
            })}
          </ul>
        </div>
      ))}
      <div class="col">
        <h2>{f.cols.contacts}</h2>
        <ul>
          <li>{isBlank(COMPANY.email) ? COMPANY.email : <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>}</li>
          <li>{isBlank(COMPANY.phone) ? COMPANY.phone : <a href={`tel:${COMPANY.phone.replace(/[^+\d]/g, "")}`}>{COMPANY.phone}</a>}</li>
          <li><a href={BOT_URL}>Telegram: {COMPANY.support}</a></li>
          <li class="desk">{ru ? COMPANY.addressRu : COMPANY.addressKk}</li>
          <li class="desk">{ru ? COMPANY.hoursRu : COMPANY.hoursKk}</li>
        </ul>
      </div>
      </div>
    </div>

    <div class="bottom">
      <div class="req">
        <p>{ru ? COMPANY.nameRu : COMPANY.nameKk} · {f.bin} {COMPANY.bin} · {f.legal}: {ru ? COMPANY.legalAddressRu : COMPANY.legalAddressKk}</p>
        <p class="muted">{f.bank}: {ru ? COMPANY.bankRu : COMPANY.bankKk} · {f.iik} {COMPANY.iik} · © 2026 Medeo</p>
      </div>
      <div class="end">
        <p class="langs"><a href={L === "kk" ? path : otherLang(path, L)} lang="kk">Қаз</a> · <a href={L === "ru" ? path : otherLang(path, L)} lang="ru">Рус</a></p>
        <PayLogos />
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: 48px; padding-bottom: 32px; }
  .box { background: #15171a; color: #f2f3f0; border-radius: 32px; padding: 64px 56px 40px; }
  .badges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; list-style: none; margin: 0; padding: 0; }
  .badges li { display: flex; gap: 14px; align-items: flex-start; padding: 20px; border-radius: 20px; background: #34383e; font-size: 15px; line-height: 22px; }
  .badges b { display: block; font-weight: 500; font-size: 16px; line-height: 20px; margin-bottom: 4px; }
  .badges .d { color: #c4c8ce; }
  .ic { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--lime); color: #15171a; }
  .short, .badges b.short { display: none; }
  .mid { display: grid; grid-template-columns: 1.65fr 5fr; gap: 24px; margin-top: 56px; }
  .cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .logo { font-family: var(--font-display); font-weight: 600; font-size: 32px; letter-spacing: -0.02em; }
  .brand p { margin: 20px 0; color: #c4c8ce; font-size: 15px; line-height: 22px; max-width: 290px; }
  .tg { display: inline-flex; align-items: center; gap: 12px; padding: 8px 16px 8px 8px; border-radius: 16px; background: #34383e; max-width: 290px; }
  .tg :global(svg) { border-radius: 6px; flex: none; }
  .tg b { display: block; font-weight: 500; font-size: 14px; }
  .tg span span { font-size: 14px; color: #c4c8ce; }
  .col h2 { margin: 8px 0 18px; font-weight: 400; font-size: 14px; line-height: 18px; color: #8c9199; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: 15px; line-height: 22px; }
  .col a:hover { color: var(--lime); }
  .bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 56px; padding-top: 24px; border-top: 1px solid #2b2f35; }
  .req p { margin: 0; font-size: 15px; line-height: 22px; }
  .req .muted { color: #8c9199; margin-top: 4px; }
  .end { display: flex; align-items: center; gap: 20px; }
  .langs { margin: 0; font-size: 14px; white-space: nowrap; }
  @media (max-width: 1100px) {
    .box { padding: 40px 32px 32px; }
    .badges { grid-template-columns: 1fr 1fr; }
    .mid { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr 1fr 1fr; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 720px) {
    .foot { margin-top: 20px; padding-bottom: 16px; }
    .box { border-radius: 24px; padding: 28px 20px 24px; }
    .full, .desk, .badges .d { display: none; }
    .short, .badges b.short { display: inline; }
    .badges b.full { display: none; }
    .brand p.short { display: block; }
    .mid { display: contents; }
    .brand { order: 1; }
    .badges { display: flex; flex-wrap: wrap; gap: 8px; order: 2; margin-bottom: 28px; }
    .cols { order: 3; grid-template-columns: 1fr 1fr; gap: 24px 16px; }
    .badges li { padding: 8px 12px; border-radius: 999px; gap: 0; }
    .badges b { margin: 0; font-size: 14px; }
    .ic { display: none; }
    .box { display: flex; flex-direction: column; }
    .brand p { margin: 8px 0 16px; }
    .tg { display: none; }
    .col:nth-child(3) { display: none; } /* «Компания» — мобильде жоқ (Figma) */
    .bottom { order: 4; margin-top: 24px; }
    .end { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>

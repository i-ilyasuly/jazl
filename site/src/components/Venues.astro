<script>
  // 100 ₸ жолақтары экранға шыққанда толады
  const h = document.querySelector<HTMLElement>(".hundred");
  if (h) {
    if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) h.classList.add("in");
    else new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { h.classList.add("in"); o.disconnect(); } }), { threshold: 0.3 }).observe(h);
  }
</script>

---
// «Мекемелерге» беті (Figma 76:5424 / 80:5563, мобиль 78:5547 / 80:6172). Бір DOM, екі макет.
// Өтінім формасы → POST {API}/v1/site/lead (бэкенд: routes/site.ts) → Басқаруға Telegram хабарламасы.
import type { Dict } from "../i18n/kk";
import { VENUES, HOURS_CHART } from "../i18n/venues";
import { API_URL, BOT_URL, VENUE_APPLY_URL } from "../config";
import { href } from "../routes";
import Icon from "./Icon.astro";
import Contour from "./Contour.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const L = t.lang as "kk" | "ru";
const v = VENUES[L];
const f = v.form;
const maxH = Math.max(...HOURS_CHART.map((x) => x[1]));
---
<!-- ── 1. Hero (Figma-да күндізгі режимге бекітілген: түнде де қара) ── -->
<section class="v-hero day" aria-labelledby="vh-title">
  <Contour class="vh-contour" opacity={0.12} />
  <svg class="vh-mtn" viewBox="0 0 520 260" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
    <path d="M40 260 170 120 230 170 330 60 420 140 520 90V260Z" fill="#2a2d33" />
    <path d="M150 260 260 170 320 200 410 120 520 170V260Z" fill="#212429" />
    <path d="M330 60l30 26-16 6-30-12Z" fill="#d6d8dc" />
    <path d="M520 90l-24 15 14 8 10-4Z" fill="#d6d8dc" />
  </svg>
  <div class="vh-in">
    <p class="badge t-label-s"><i></i>{v.hero.badge}</p>
    <h1 id="vh-title" class="vh-title"><span>{v.hero.line1}</span><span class="lime">{v.hero.line2}</span></h1>
    <div class="vh-low">
      <div>
        <p class="t-body-l vh-lead">{v.hero.lead}</p>
        <div class="vh-btns">
          <a class="btn btn-primary" href="#apply">{v.hero.apply}</a>
          <a class="btn vh-ghost" href={BOT_URL}>{v.hero.demo}</a>
        </div>
      </div>
      <ul class="vh-stats">
        {v.hero.stats.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<!-- ── 2. Әр 100 ₸ ── -->
<section class="card hundred" aria-labelledby="h100">
  <Contour class="h-contour" sun={false} />
  <div class="h-text">
    <h2 id="h100" class="t-display-l">{v.hundred.title}</h2>
    <p class="t-body-s muted">{v.hundred.lead}</p>
  </div>
  <div class="h-bars">
    {v.hundred.rows.map((r) => (
      <div class="h-row">
        <p class="h-head"><b class="t-label-m">{r.name}</b><span class="t-label-s muted">{r.note}</span></p>
        <div class="track"><div class:list={["fill", r.hi && "hi"]} style={`--p:${r.pct}%`}><span>{r.value}</span></div></div>
      </div>
    ))}
  </div>
</section>

<!-- ── 3. Пайдасы (бенто) ── -->
<section class="benefits" aria-labelledby="vb-title">
  <h2 id="vb-title" class="t-display-l">{v.benefits.title}</h2>
  <div class="bento">
    <div class="chart-card day">
      <h3 class="t-heading-m">{v.benefits.chartTitle}</h3>
      <p class="t-body-m soft">{v.benefits.chartLead}</p>
      <ol class="chart" aria-hidden="true">
        {HOURS_CHART.map(([h, total, medeo]) => (
          <li>
            <span class="col" style={`--t:${(total / maxH) * 100}%`}><i class="m" style={`--m:${(medeo / total) * 100}%`}></i></span>
            <span class="hr">{h}</span>
          </li>
        ))}
      </ol>
      <p class="legend t-label-s"><span><i class="lb"></i>{v.benefits.legendBase}</span><span><i class="lm"></i>{v.benefits.legendMedeo}</span></p>
    </div>
    <ul class="b-cards">
      {v.benefits.cards.map((c) => (
        <li class:list={[`tone-${c.tone}`, c.tone === "lime" && "day"]}>
          <h3 class="t-heading-s">{c.t}</h3>
          <p class="t-body-s soft">{c.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ── 4. Тауға шығу ── -->
<section class="card climb" aria-labelledby="vc-title">
  <Contour class="c-contour" sun={false} />
  <div class="c-text">
    <h2 id="vc-title" class="t-display-l">{v.climb.title}</h2>
    <p class="t-body-m muted">{v.climb.lead}</p>
  </div>
  <ol class="c-steps">
    {v.climb.steps.map((s, i) => (
      <li>
        <div class="rail"><span class="t-label-s">{s.h}</span><i class:list={["dot", i === 0 && "top"]}></i></div>
        <div class:list={["step", `tone-${s.tone}`, s.tone === "lime" && "day"]}>
          <h3 class="t-heading-s">{s.t}</h3>
          <p class="t-body-s soft">{s.d}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<!-- ── 5. Шарттар ── -->
<section id="terms" class="terms" aria-labelledby="vt-title">
  <div class="t-main day">
    <Contour class="t-contour" opacity={0.12} />
    <p class="t-label-s kicker">{v.terms.kicker}</p>
    <h2 id="vt-title" class="t-display-l">{v.terms.title}</h2>
    <ul class="t-stats">
      {v.terms.stats.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}
    </ul>
    <p class="t-body-s t-note">{v.terms.note}</p>
  </div>
  <div class="t-rate day">
    <h3 class="t-heading-m">{v.terms.rateTitle}</h3>
    <p class="t-body-s soft">{v.terms.rateLead}</p>
    <ul>
      {v.terms.rates.map(([a, b]) => <li><span class="t-label-m">{a}</span><span class="discount">{b}</span></li>)}
    </ul>
  </div>
</section>

<!-- ── 6. Жиі сұрақтар ── -->
<section class="v-faq" aria-labelledby="vq-title">
  <h2 id="vq-title" class="t-display-l">{v.faq.title}</h2>
  <ul>
    {v.faq.items.map(([q, a]) => <li class="card"><h3 class="t-heading-s">{q}</h3><p class="t-body-s soft">{a}</p></li>)}
  </ul>
</section>

<!-- ── 7. Өтінім ── -->
<section id="apply" class="card apply" aria-labelledby="va-title">
  <Contour class="a-contour" />
  <div class="a-text">
    <h2 id="va-title" class="t-display-l">{f.title}</h2>
    <p class="t-body-l soft">{f.lead}</p>
    <ul class="checks">
      {f.checks.map((c) => <li class="t-body-m"><span class="ck day" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="m6 12 4 4 8-8" fill="none" stroke="#15171a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{c}</li>)}
    </ul>
  </div>

  <form class="form" data-lead data-api={`${API_URL}/v1/site/lead`} data-lang={L} data-ok={f.ok} data-ok-no={f.okNo} data-err={f.err} data-sending={f.sending} data-fields={JSON.stringify(f.errFields)} novalidate>
    <label class="fld"><span class="t-label-s">{f.venue}</span><input name="venue" required minlength="2" maxlength="80" placeholder={f.venuePh} autocomplete="organization" /></label>
    <fieldset class="fld">
      <legend class="t-label-s">{f.kind}</legend>
      <div class="seg">
        {(["coffee", "food", "hair"] as const).map((k, i) => <label><input type="radio" name="kind" value={k} checked={i === 0} /><span>{f.kinds[k]}</span></label>)}
      </div>
    </fieldset>
    <div class="two">
      <label class="fld"><span class="t-label-s">{f.name}</span><input name="name" required minlength="2" maxlength="60" placeholder={f.namePh} autocomplete="name" /></label>
      <label class="fld"><span class="t-label-s">{f.phone}</span><input name="phone" type="tel" required inputmode="tel" placeholder={f.phonePh} autocomplete="tel" /></label>
    </div>
    <label class="fld"><span class="t-label-s">{f.pos}</span>
      <span class="sel"><select name="pos"><option value="">{f.posPh}</option>{f.posOptions.map((o) => <option value={o}>{o}</option>)}</select><Icon name="down" size={16} /></span>
    </label>
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="consent t-body-s"><input type="checkbox" name="consent" required /><span><a href={href(L, "personal")} target="_blank">{f.consentA}</a>{f.consentB}</span></label>
    <p class="msg t-body-s" role="status" aria-live="polite" hidden></p>
    <button class="btn btn-primary" type="submit">{f.submit}</button>
    <p class="t-body-s muted or">{f.or} <a class="link" href={VENUE_APPLY_URL}>@Mmedeo_bot</a></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-lead]");
  if (form) {
    const msg = form.querySelector<HTMLElement>(".msg")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const labels: Record<string, string> = JSON.parse(form.dataset.fields ?? "{}");
    const show = (text: string, ok: boolean) => { msg.hidden = false; msg.textContent = text; msg.classList.toggle("ok", ok); msg.classList.toggle("bad", !ok); };
    const mark = (names: string[]) => form.querySelectorAll<HTMLElement>("input,select").forEach((el) => {
      const n = el.getAttribute("name") ?? ""; el.toggleAttribute("aria-invalid", names.includes(n));
    });
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = {
        venue: String(fd.get("venue") ?? "").trim(), kind: String(fd.get("kind") ?? "coffee"), name: String(fd.get("name") ?? "").trim(),
        phone: String(fd.get("phone") ?? "").trim(), pos: String(fd.get("pos") ?? ""), consent: fd.get("consent") === "on",
        lang: form.dataset.lang, website: String(fd.get("website") ?? ""),
      };
      const bad: string[] = [];
      if (data.venue.length < 2) bad.push("venue");
      if (data.name.length < 2) bad.push("name");
      if (data.phone.replace(/\D/g, "").length < 10) bad.push("phone");
      if (!data.consent) bad.push("consent");
      mark(bad);
      if (bad.length) { show(bad.map((b) => labels[b]).filter(Boolean).join(" · "), false); return; }
      btn.disabled = true; const label = btn.textContent; btn.textContent = form.dataset.sending ?? "…";
      try {
        const r = await fetch(form.dataset.api!, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
        const j = await r.json().catch(() => null);
        if (r.ok && j?.ok) {
          form.reset();
          show(`${form.dataset.ok} ${(form.dataset.okNo ?? "").replace("{no}", String(j.no))}`, true);
        } else {
          const fields: string[] = j?.fields ?? []; mark(fields);
          show(fields.length ? fields.map((x) => labels[x]).filter(Boolean).join(" · ") || (form.dataset.err ?? "") : form.dataset.err ?? "", false);
        }
      } catch { show(form.dataset.err ?? "", false); }
      finally { btn.disabled = false; btn.textContent = label; }
    });
  }
</script>

<style>
  /* ── 1. Hero ── */
  .v-hero { position: relative; overflow: hidden; border-radius: 40px; background: #15171a; color: #f2f3f0; min-height: 636px; box-sizing: border-box; padding: 64px; }
  :global(.vh-contour) { position: absolute; right: -40px; top: -60px; width: 340px; color: #fff; }
  .vh-mtn { position: absolute; right: 0; bottom: 0; width: 520px; height: 260px; }
  .vh-in { position: relative; display: flex; flex-direction: column; gap: 40px; height: 100%; }
  .badge { display: inline-flex; align-self: flex-start; align-items: center; gap: 10px; margin: 0; padding: 8px 16px; border-radius: 999px; background: rgb(255 255 255 / .08); }
  .badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); }
  .vh-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 88px; line-height: 96px; letter-spacing: -0.03em; }
  .vh-title span { display: block; }
  .vh-title .lime { color: var(--lime); }
  .vh-low { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .vh-lead { margin: 0 0 28px; max-width: 620px; color: #c4c8ce; }
  .vh-btns { display: flex; gap: 12px; }
  .vh-ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .3); }
  .vh-ghost:hover { background: rgb(255 255 255 / .08); }
  .vh-stats { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .vh-stats li { width: 170px; padding: 20px; box-sizing: border-box; border-radius: 20px; background: rgb(255 255 255 / .08); backdrop-filter: blur(6px); }
  .vh-stats b { display: block; font-family: var(--font-display); font-weight: 500; font-size: 30px; line-height: 38px; }
  .vh-stats span { display: block; margin-top: 4px; font-size: 14px; line-height: 18px; color: #c4c8ce; }

  /* ── 2. 100 ₸ ── */
  .hundred { position: relative; overflow: hidden; display: grid; grid-template-columns: 380px 1fr; gap: 96px; align-items: center; padding: 48px; }
  :global(.h-contour) { position: absolute; left: -90px; bottom: -120px; width: 340px; color: var(--ink); }
  .h-text { position: relative; }
  .h-text h2 { margin: 0 0 20px; }
  .h-text p { margin: 0; }
  .h-bars { display: grid; gap: 28px; }
  .h-head { display: flex; justify-content: space-between; margin: 0 0 10px; }
  .track { height: 72px; border-radius: 16px; background: var(--gray-100); overflow: hidden; }
  .fill { width: 0; height: 100%; display: flex; align-items: center; padding-left: 20px; box-sizing: border-box; border-radius: 16px; background: var(--gray-300); transition: width 1.2s cubic-bezier(.2,.8,.2,1); }
  .fill.hi { background: var(--lime); color: #15171a; }
  .fill span { font-family: var(--font-display); font-weight: 600; font-size: 28px; white-space: nowrap; }
  .hundred:global(.in) .fill { width: var(--p); }

  /* ── 3. Бенто ── */
  .benefits h2 { margin: 0 0 24px; }
  .bento { display: grid; grid-template-columns: 640fr 648fr; gap: 24px; }
  .chart-card { background: var(--lilac); color: #15171a; border-radius: 32px; padding: 40px; }
  .chart-card h3 { margin: 0 0 12px; }
  .chart-card p { margin: 0; }
  .chart { display: grid; grid-template-columns: repeat(13, 1fr); gap: 14px; align-items: end; height: 150px; list-style: none; margin: 24px 0 8px; padding: 0; }
  .chart li { display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; gap: 8px; }
  .col { position: relative; display: flex; flex-direction: column; justify-content: flex-start; width: 100%; height: calc(var(--t) * .78); border-radius: 6px; background: #f3efff; overflow: hidden; transform-origin: bottom; }
  .col .m { display: block; height: var(--m); background: #15171a; border-radius: 6px 6px 0 0; }
  .hr { font-weight: 500; font-size: 14px; line-height: 18px; }
  .legend { display: flex; gap: 20px; margin: 4px 0 0 !important; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 12px; height: 12px; border-radius: 3px; }
  .lb { background: #f3efff; } .lm { background: #15171a; }
  .b-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .b-cards li { border-radius: 24px; padding: 28px; }
  .b-cards h3 { margin: 0 0 12px; }
  .b-cards p { margin: 0; }
  .tone-peach { background: var(--peach); } .tone-ice { background: var(--ice); } .tone-paper { background: var(--paper); } .tone-lime { background: var(--lime); color: #15171a; } .tone-lilac { background: var(--lilac); }

  /* ── 4. Тауға шығу ── */
  .climb { position: relative; overflow: hidden; display: grid; grid-template-columns: 340px 1fr; gap: 96px; padding: 56px; border-radius: 40px; }
  :global(.c-contour) { position: absolute; left: -110px; bottom: -150px; width: 360px; color: var(--ink); }
  .c-text { position: relative; }
  .c-text h2 { margin: 0 0 16px; }
  .c-text p { margin: 0; }
  .c-steps { display: grid; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .c-steps li { display: grid; grid-template-columns: 96px 1fr; gap: 8px; }
  .rail { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 2px; }
  .rail span { color: var(--gray-500); white-space: nowrap; }
  .c-steps li:first-child .rail span { color: var(--ink); }
  .dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--ink); }
  .dot.top { background: var(--lime); }
  .c-steps li:not(:last-child) .rail::after { content: ""; position: absolute; top: 52px; bottom: -14px; width: 2px; background: var(--gray-300); }
  .step { border-radius: 20px; padding: 24px 28px; }
  .step h3 { margin: 0 0 8px; }
  .step p { margin: 0; }

  /* ── 5. Шарттар ── */
  .terms { display: grid; grid-template-columns: 868fr 420fr; gap: 24px; }
  .t-main { position: relative; overflow: hidden; border-radius: 32px; padding: 48px; background: #15171a; color: #f2f3f0; }
  :global(.t-contour) { position: absolute; right: -40px; top: -40px; width: 300px; color: #fff; }
  .kicker { margin: 0 0 12px; color: var(--lime); position: relative; }
  .t-main h2 { margin: 0; max-width: 620px; position: relative; }
  .t-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; list-style: none; margin: 40px 0 28px; padding: 0; position: relative; }
  .t-stats li { padding: 24px; border-radius: 20px; background: rgb(255 255 255 / .08); }
  .t-stats b { display: block; font-family: var(--font-display); font-weight: 600; font-size: 48px; line-height: 56px; }
  .t-stats span { display: block; margin-top: 6px; font-size: 15px; line-height: 22px; color: #c4c8ce; }
  .t-note { margin: 0; color: #c4c8ce; position: relative; }
  .t-rate { border-radius: 32px; padding: 40px; background: var(--lime); color: #15171a; }
  .t-rate h3 { margin: 0 0 12px; }
  .t-rate p { margin: 0 0 24px; }
  .t-rate ul { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .t-rate li { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-radius: 16px; background: #fff; }

  /* ── 6. Сұрақтар ── */
  .v-faq h2 { margin: 0 0 24px; }
  .v-faq ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; list-style: none; margin: 0; padding: 0; }
  .v-faq li { padding: 28px; border-radius: 24px; }
  .v-faq h3 { margin: 0 0 12px; }
  .v-faq p { margin: 0; }

  /* ── 7. Өтінім ── */
  .apply { position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr 560px; gap: 48px; padding: 48px; scroll-margin-top: 120px; }
  :global(.a-contour) { position: absolute; left: -60px; bottom: -110px; width: 340px; color: var(--ink); }
  .a-text { position: relative; }
  .a-text h2 { margin: 0 0 16px; }
  .a-text > p { margin: 0 0 28px; max-width: 600px; }
  .checks { display: grid; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .checks li { display: flex; align-items: center; gap: 12px; }
  .ck { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--lime); }
  .form { position: relative; display: grid; gap: 18px; padding: 32px; border-radius: 24px; background: var(--gray-100); }
  .fld { display: grid; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .fld > span, .fld legend { color: var(--ink-2); padding: 0; }
  .form input:not([type=radio]):not([type=checkbox]), .sel select {
    width: 100%; height: 52px; box-sizing: border-box; padding: 0 18px; border-radius: 999px; border: 1.5px solid transparent;
    background: var(--paper); color: var(--ink); font: 400 16px/20px var(--font-sans); outline: none; -webkit-appearance: none; appearance: none;
  }
  .form input:focus, .sel select:focus { border-color: var(--blue); }
  .form [aria-invalid] { border-color: #e5484d !important; }
  .form ::placeholder { color: var(--gray-500); }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); padding: 4px; border-radius: 999px; background: var(--paper); }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span { display: block; text-align: center; padding: 11px 8px; border-radius: 999px; font-weight: 500; font-size: 15px; line-height: 18px; }
  .seg input:checked + span { background: var(--ink); color: var(--snow); }
  .seg input:focus-visible + span { outline: 2px solid var(--blue); outline-offset: 2px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sel { position: relative; display: block; }
  .sel :global(svg) { position: absolute; right: 18px; top: 18px; pointer-events: none; color: var(--gray-500); }
  .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .consent { display: flex; gap: 10px; align-items: center; color: var(--ink-2); }
  .consent input { width: 20px; height: 20px; accent-color: var(--ink); margin: 0; }
  .consent input[aria-invalid] { outline: 2px solid #e5484d; outline-offset: 2px; }
  .consent a { text-decoration: underline; text-underline-offset: 3px; }
  .form .btn { width: 100%; }
  .form .btn:disabled { opacity: .6; }
  .msg { margin: 0; padding: 12px 16px; border-radius: 14px; }
  .msg.ok { background: var(--discount-bg); color: var(--discount-text); }
  .msg.bad { background: color-mix(in srgb, #e5484d 14%, transparent); color: #c4242a; }
  :global([data-theme="dark"]) .msg.bad { color: #ff8a8e; }

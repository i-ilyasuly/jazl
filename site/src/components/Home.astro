---
// Басты бет (Figma: десктоп 10:417 / 42:826, мобиль 28:736 / 42:1550). Бір DOM, екі макет — CSS арқылы.
// Үлгі бөлімдер (танымал ұсыныстар, пікірлер) тек DEMO режимінде: нақты деректер келгенде API-ден толтырылады.
import type { Dict } from "../i18n/kk";
import { API_URL, APP_URL, BOT_URL, DEMO } from "../config";
import { href } from "../routes";
import Icon from "./Icon.astro";
import Pass from "./Pass.astro";
import PayLogos from "./PayLogos.astro";
import Qr from "./Qr.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const L = t.lang;
const sv = t.savings;
const first = sv.tabs[0];
---
<!-- ── 1. Басты экран ─────────────────────────────────── -->
<section class="hero" aria-labelledby="h-title">
  <div class="card hero-main">
    <svg class="decor" viewBox="0 0 768 640" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
      <g fill="none" stroke="var(--ink)" stroke-opacity=".07" stroke-width="1.5">
        <path d="M728 60l2.8 3.4 1.4 3.6-.5 3.7-2.4 3.1-4.1 2.3-4.8 1.5-4.9 1-4.2.8-3.3 1.2-2.6 2-2.4 2.8-2.6 3.1-3.5 3-4.2 2.2-4.7.8-4.7-.8-4.2-2.2-3.5-3-2.6-3.1-2.4-2.8-2.6-2-3.3-1.2-4.2-.8-4.9-1-4.8-1.5-4.1-2.3-2.4-3.1-.5-3.7 1.4-3.6L648 60l3.2-2.9 2.8-2.5 1.7-2.5.5-2.7-.2-3.3-.4-3.7.4-4 1.8-3.6 3.2-2.7 4.4-1.5 5.1-.1 5.1 1 4.7 1.4 4.1 1.1 3.6.5 3.6-.5 4.1-1.1 4.7-1.4 5.1-1 5.1.1 4.4 1.5 3.2 2.7 1.8 3.6.4 4-.4 3.7-.2 3.3.5 2.7 1.7 2.5 2.8 2.5z"/>
        <path d="M759 60l.6 5.6-1.8 5.5-3.9 4.9-5.3 4.2-5.8 3.5-5.5 3.2-4.7 3.2-4 3.7-3.7 4.3-4 4.6-4.9 4.4-6 3.6-7 2.1-7.5.4-7.5-1.3-6.9-2.5-6.3-3-5.6-2.9-5.6-2.4-5.9-1.7-6.6-1.3-7.1-1.5-7.1-2.1-6.4-3.2-4.8-4.3-2.9-5.2-.7-5.8 1.1-5.7 1.9-5.3L627 60l1.3-4.7.4-4.8-.4-5L628 40l.5-5.8 2-5.5 4-4.8 5.8-3.7 7-2.2 7.6-1.1 7.4-.2 6.9-.2 6.3-.5 6.2-1.3 6.3-1.8 6.9-1.9 7.4-1.4 7.7-.3 7.3 1.4 6.4 3 5 4.3 3.7 5.1 2.6 5.2 2.3 4.8 2.7 4.4 3.4 4 4.3 4 4.6 4.3 4.1 4.8z"/>
        <path d="M785.5 60l-2.5 7.5-4.5 6.9-5.4 6.3-5.5 5.9-5.1 5.7-4.5 5.9-4.2 6.2-4.6 6.6-5.7 6.3-7.1 5.6-8.6 4.2-9.7 2.4-10.2.5-10.2-1-9.7-1.9-9.1-2.1-8.8-1.9-8.8-1.4-9.3-1-9.7-1.3-9.8-2.1-9.3-3.3-8-4.8-6-6.2-3.9-7.2-1.9-7.6-.5-7.5-.1-7.1-.4-6.9-.9-6.7-1.5-6.9-1.4-7.4-.5-7.6 1.4-7.7 3.7-7.1 6-6.3 7.8-4.9 9.1-3.7 9.3-2.7 9-2.3 8.6-2.3 8.3-2.8 8.3-3.2 8.8-3.3 9.6-2.7 10.1-1.4 10.3.4 9.7 2.4 8.7 4.1 7.5 5.3 6.3 5.8 5.7 5.7 5.6 5.4 6.1 5 6.7 5 6.8 5.3 6.4 6 4.9 6.8 2.6 7.4z"/>
        <path d="M806.8 60l-3.7 9.1-4.3 8.6-4.2 8.3-3.9 8.3-3.7 8.6-4.2 8.7-5.4 8.7-7.3 8.1-9.2 6.8-11.1 5.1-12.3 3.1-12.8 1.4-12.6.1-12.3-.4L688 144l-11.8-.1-12-.1-12.4-.2-12.7-1.2-12.5-2.7-11.5-4.5-9.8-6.3-7.7-7.8-5.7-8.7-4.2-9-3.2-8.8-3.1-8.6-3.4-8.5-3.7-8.5-3.5-9-2.4-9.4-.4-9.7 2.1-9.6 5-9 7.5-7.9 9.3-6.8 10.1-5.7 10.2-5 9.9-4.9 9.7-5 9.7-5.3 10.3-5.3 11.2-4.6 12.2-3.3L688-33l12.9.8 12.4 2.9 11.4 4.5 10.4 5.5 9.5 5.7 9.3 5.6 9.3 5.3 9.7 5.3 9.9 5.8 9.3 6.5 8 7.7 5.8 8.7 3 9.4.1 9.8z"/>
        <path d="M827.5 60l-2.1 10.8-2.1 10.8-2.1 10.9-2.7 11.1-4.1 11.1-6.2 10.8-8.8 9.7-11.3 8.2-13.2 6.4-14.3 4.5-14.8 3-14.7 2.2-14.4 1.8-14.2 1.9-14.5 1.9-14.9 1.5-15.4.5-15.6-1.1-15.1-3.3-13.8-5.5-12.1-7.4-10.2-8.9-8.4-9.6-7.3-9.8-6.8-9.7-6.8-9.6-6.8-9.7-6.6-10.2-5.4-10.9-3.3-11.4-.6-11.8 2.7-11.5 5.7-11 8.1-10 9.6-9 10.2-8.2 10.2-7.8 10-7.8 10.3-7.9 10.9-7.8 12-7.2 13.5-6 14.7-4 15.6-1.6 15.6.7 15.2 2.7 14.3 4 13.6 4.7 13.1 4.9 13 4.7 13.1 4.9 13.3 5.4 12.9 6.3 11.7 7.8 9.6 9.3 6.9 10.5 4 11.4 1.3 11.7-.7 11.5z"/>
        <path d="M852.2 60l.8 13-.1 13.3-1.6 13.5-4 13.4-7 12.7-10.1 11.6-12.8 9.9-14.7 8.1-15.8 6.6-16.1 5.5-16 4.9-16 4.7-16.3 4.5-16.9 4.1-17.6 3-18.2 1.2-18.4-1-17.7-3.6-16.5-6.1-14.9-8-13.2-9.2-11.9-9.8-11.2-9.9-10.9-10-10.7-10.2-10.4-10.8-9.3-11.6-7.2-12.6-4.4-13.4-.9-13.8 2.6-13.7 5.5-13 7.6-12.3 8.8-11.5 9.1-11.1 9.3-10.8 9.6-10.8 10.5-10.8 11.9-10.2 13.7-9 15.7-7.3 17.2-4.9 18.1-2.3 18.3-.1 17.9 1.6 17.3 2.6 16.8 3.2 16.7 3.2 16.7 3.6 16.8 4.1 16.6 5.3 15.8 7 14 9 11.5 10.7 8.6 12.2 5.8 13 3.5 13.3 1.9 13.2 1.3 12.9z"/>
      </g>
      <circle cx="688" cy="60" r="22" fill="var(--lime)" />
      <path d="M291.84 640L422.4 470 476.16 520 576 410 660.48 490 768 430V640Z" fill="var(--mtn-1)" />
      <path d="M384 640L522.24 510 583.68 550 691.2 470 768 520V640Z" fill="var(--mtn-2)" />
      <path d="M576 410l30.72 28-15.36 6-30.72-14Z" fill="var(--mtn-snow)" />
      <path d="M691.2 470l26.88 24-15.36 5-23.04-11Z" fill="var(--mtn-snow)" />
    </svg>
    <div class="hero-text">
      <h1 id="h-title" class="t-display-xl">{t.hero.title}</h1>
      <p class="t-body-l soft">{t.hero.lead}</p>
    </div>
    <div class="hero-actions">
      <div class="btns">
        <a class="btn btn-primary" href={APP_URL}><Icon name="telegram" size={20} />{t.nav.open}<Icon name="arrowUpRight" size={16} /></a>
        <a class="btn btn-ghost" href={href(L, "venues")}>{t.hero.venues}</a>
      </div>
      <div class="scan">
        <Qr url={APP_URL} size={60} label={t.hero.scan} />
        <span class="t-body-s">{t.hero.scan}</span>
      </div>
    </div>
  </div>

  <div class="hero-pass" aria-hidden="false">
    <div class="back" aria-hidden="true">
      <p class="t-body-s">{t.pass.backVenue}</p>
      <p class="t-heading-s">{t.pass.backTitle}</p>
    </div>
    <div class="front"><Pass t={t} /></div>
  </div>
</section>

<!-- ── 2. Үш қадам ─────────────────────────────────────── -->
<section id="how" class="steps" aria-labelledby="s-title">
  <div class="steps-intro day">
    <h2 id="s-title" class="t-heading-m">{t.steps.title}</h2>
    <p class="t-body-s soft">{t.steps.lead}</p>
  </div>
  <ol class="card steps-list">
    {t.steps.items.map((s, i) => (
      <li>
        <span class="num" class:list={[i === 0 && "on"]}>{i + 1}</span>
        <h3 class="t-heading-s">{s.t}</h3>
        <p class="t-body-m soft">{s.d}</p>
      </li>
    ))}
  </ol>
</section>

<!-- ── 3. Танымал ұсыныстар (үлгі) ─────────────────────── -->
{DEMO && (
  <section class="popular" aria-labelledby="p-title">
    <h2 id="p-title" class="t-display-l">{t.popular.title}</h2>
    <ul class="offers">
      {t.popular.items.map((o) => (
        <li class:list={["offer", o.tone === "lime" && "day"]}>
          <a href={APP_URL}>
            <div class={`top tone-${o.tone}`}>
              <p class="t-label-s v">{o.venue} <Icon name="verified" size={16} class="ok" /></p>
              <p class="t-heading-s">{o.title}</p>
            </div>
            <div class="bot">
              <div>
                <p class="price">{o.price}</p>
                <p class="t-body-s muted">{o.units}</p>
              </div>
              <span class="discount">▼ {o.off}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="t-body-s muted note">{t.popular.note}</p>
  </section>
)}

<!-- ── 4. Үнем есебі және қорғау ────────────────────────── -->
<section class="save-row">
  <div class="calc day" data-calc data-tabs={JSON.stringify(sv.tabs)} data-explain={sv.explain} data-each={sv.explainEach} data-week={sv.freq.week} data-month={sv.freq.month} aria-labelledby="c-title">
    <h2 id="c-title" class="t-heading-m">{sv.title}</h2>
    <div class="seg" role="tablist" aria-label={sv.title}>
      {sv.tabs.map((x, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={x.id}>{x.label}</button>)}
    </div>
    <p class="sum" aria-live="polite"><span class="t-number-xl big" data-out="sum">3 900 ₸</span> <span class="t-body-l">{sv.perMonth}</span></p>
    <div class="dots" data-out="dots" aria-hidden="true"></div>
    <p class="t-label-s" data-out="explain"></p>
    <label class="range">
      <span class="t-label-m" data-out="freq"></span>
      <span class="t-label-s" data-out="price"></span>
      <input type="range" min={first.min} max={first.max} value={first.value} step="1" data-in="freq" aria-label={sv.title} />
    </label>
  </div>

  <div class="protect" aria-labelledby="g-title">
    <h2 id="g-title" class="t-heading-m">{t.protect.title}</h2>
    <dl>
      {t.protect.rows.map(([a, b]) => <div><dt class="t-label-m">{a}</dt><dd class="t-body-s">{b}</dd></div>)}
    </dl>
  </div>
</section>

<!-- ── 5. Пікірлер: мини апптағы нақты пікірлер (4–5 жұлдыз, мәтіні бар), жоқ болса — үлгі (DEMO). Карталар кезекпен ауысады ── -->
<section class="reviews" aria-labelledby="r-title" data-reviews hidden={!DEMO}
  data-api={`${API_URL}/v1/catalog/site-reviews`} data-demo={DEMO ? JSON.stringify(t.reviews.items) : "[]"}
  data-kinds={JSON.stringify(t.reviews.kinds)} data-count-tpl={t.reviews.countTpl}>
  <div class="stack-cards" aria-live="polite">
    {[0, 1, 2].map((i) => {
      const r = t.reviews.items[i];
      return (
        <figure class:list={["rv", `tone-${r.tone}`]} data-slot={i}>
          <span class="chip t-label-s" data-f="cat">{r.cat}</span>
          <p class="stars" data-f="stars" aria-label="5/5">★★★★★</p>
          <blockquote class="t-body-l" data-f="text">{r.text}</blockquote>
          <figcaption class="t-label-s"><b data-f="who">{r.who}</b> <span class="muted" data-f="venue">{r.venue}</span> <Icon name="verified" size={14} class="ok" /></figcaption>
        </figure>
      );
    })}
  </div>
  <div class="r-text">
    <h2 id="r-title" class="t-display-l">{t.reviews.title}</h2>
    <p class="t-body-l soft">{t.reviews.lead}</p>
    <div class="avg"><span class="t-number-xl" data-f="avg">{t.reviews.avg}</span><span><span class="stars">★★★★★</span><span class="t-body-s soft" data-f="count">{t.reviews.count}</span></span></div>
    <a class="t-label-m link" href={APP_URL}>{t.reviews.all}</a>
  </div>
</section>

<!-- ── 5б. Серіктестер (үлгі белгілер, DEMO): жүгіртпе жол ── -->
{DEMO && (
  <section class="partners" aria-labelledby="pt-title">
    <div class="pt-head">
      <h2 id="pt-title" class="t-display-l">{t.partners.title}</h2>
      <a class="t-label-m link" href={href(L, "venues")}>{t.partners.cta}</a>
    </div>
    <div class="marquee">
      <ul class="track">
        {[...t.partners.names, ...t.partners.names].map((n, i) => (
          <li class={`logo l${i % t.partners.names.length}`} aria-hidden={i >= t.partners.names.length ? "true" : undefined}><span>{n}</span></li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- ── 6. Мекемеге шақыру және төлем ────────────────────── -->
<section class="cta-row">
  <div class="card venue-cta">
    <h2 class="t-heading-m">{t.venueCta.title}</h2>
    <p class="t-body-m soft">{t.venueCta.lead}</p>
    <a class="btn btn-dark inline" href={href(L, "venues")}>{t.venueCta.btn}</a>
  </div>
  <div class="payc">
    <h2 class="t-heading-m">{t.pay.title}</h2>
    <p class="t-body-m soft">{t.pay.lead}</p>
    <PayLogos />
  </div>
</section>

<!-- ── 7. Жиі сұрақтар ─────────────────────────────────── -->
<section id="faq" class="card faq" aria-labelledby="f-title">
  <div class="faq-intro">
    <h2 id="f-title" class="t-heading-m">{t.faq.title}</h2>
    <p class="t-body-s soft">{t.faq.lead} <a class="link" href={BOT_URL}>{t.faq.leadLink}</a></p>
  </div>
  <div class="faq-list">
    {t.faq.items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary class="t-label-m"><span>{q}</span><span class="pm" aria-hidden="true"><Icon name="plus" size={16} class="p" /><Icon name="minus" size={16} class="m" /></span></summary>
        <p class="t-body-s soft">{a}</p>
      </details>
    ))}
  </div>
</section>

<script>
  // Пікірлер: үш карта кезекпен ауысады (алдыңғысы артқа кетіп, келесі пікірді көрсетеді). Нақты пікірлер API-ден.
  type Rv = { cat: string; text: string; who: string; venue: string; tone: string; stars?: number };
  const rs = document.querySelector<HTMLElement>("[data-reviews]");
  if (rs) {
    const cards = [...rs.querySelectorAll<HTMLElement>(".rv")];
    const demo: Rv[] = JSON.parse(rs.dataset.demo ?? "[]");
    const kinds: Record<string, string> = JSON.parse(rs.dataset.kinds ?? "{}");
    let list: Rv[] = demo.slice();
    let next = 3;
    const fillCard = (el: HTMLElement, r: Rv) => {
      const f = (k: string) => el.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
      f("cat").textContent = r.cat; f("text").textContent = r.text; f("who").textContent = r.who; f("venue").textContent = r.venue;
      const n = r.stars ?? 5; f("stars").textContent = "★".repeat(n) + "☆".repeat(5 - n); f("stars").setAttribute("aria-label", `${n}/5`);
      el.className = `rv tone-${r.tone}`;
    };
    const rotate = () => {
      if (list.length < 2) return;
      cards.forEach((c) => { c.dataset.slot = String((Number(c.dataset.slot) + 1) % 3); });
      const back = cards.find((c) => c.dataset.slot === "0");
      if (back && list.length > 3) setTimeout(() => { fillCard(back, list[next % list.length]); next++; }, 350);
    };
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = reduce ? 0 : window.setInterval(rotate, 4500);
    rs.addEventListener("mouseenter", () => { clearInterval(timer); });
    rs.addEventListener("mouseleave", () => { if (!reduce) timer = window.setInterval(rotate, 4500); });
    const tone: Record<string, string> = { food: "peach", coffee: "paper", hair: "lilac" };
    fetch(rs.dataset.api!, { headers: { Accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((j: { count: number; avg: number | null; reviews: { name: string; stars: number; text: string; venue: string; kind: string }[] } | null) => {
        if (!j || !j.reviews?.length) return;
        const live: Rv[] = j.reviews.map((x) => ({ cat: kinds[x.kind] ?? "", text: x.text, who: x.name, venue: x.venue, tone: tone[x.kind] ?? "paper", stars: x.stars }));
        list = live.length >= 3 ? live : [...live, ...demo].slice(0, Math.max(3, live.length));
        // Ең жаңа нақты пікір — алдыңғы картада (slot 2)
        const order = [2, 1, 0];
        order.forEach((slot, i) => { const c = cards.find((x) => x.dataset.slot === String(slot)); if (c && list[i % list.length]) fillCard(c, list[i % list.length]); });
        next = 3;
        if (j.avg != null) rs.querySelector('[data-f="avg"]')!.textContent = String(j.avg).replace(".", ",");
        rs.querySelector('[data-f="count"]')!.textContent = (rs.dataset.countTpl ?? "").replace("{n}", String(j.count));
        rs.hidden = false;
      })
      .catch(() => { /* API қолжетімсіз (CORS / желі) — үлгі қалады */ });
  }

  // Үнем есебі: айына N рет, пакетпен бір бірлік арзан. Сақталатын сома = N × (толық баға − пакет бағасы).
  type Tab = { id: string; label: string; full: number; pack: number; per: "week" | "month"; min: number; max: number; value: number; unit: string };
  const box = document.querySelector<HTMLElement>("[data-calc]");
  if (box) {
    const tabs: Tab[] = JSON.parse(box.dataset.tabs ?? "[]");
    const fmt = (n: number) => n.toLocaleString("ru-RU").replace(/ /g, " ") + " ₸";
    const out = (k: string) => box.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const input = box.querySelector<HTMLInputElement>('[data-in="freq"]')!;
    let cur = tabs[0];
    const fill = (s: string, m: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(m[k] ?? ""));
    const render = () => {
      const v = Number(input.value);
      const n = cur.per === "week" ? Math.round(v * 4.33) : v;
      const paid = Math.round((n * cur.pack) / cur.full);
      const free = n - paid;
      out("sum").textContent = fmt(n * (cur.full - cur.pack));
      out("explain").textContent = free >= 1
        ? fill(box.dataset.explain ?? "", { n, paid, free, unit: cur.unit })
        : fill(box.dataset.each ?? "", { n, unit: cur.unit, d: fmt(cur.full - cur.pack) });
      out("freq").textContent = fill((cur.per === "week" ? box.dataset.week : box.dataset.month) ?? "", { v, unit: cur.unit });
      out("price").textContent = `${cur.full.toLocaleString("ru-RU").replace(/ /g, " ")} ₸ → ${fmt(cur.pack)}`;
      out("dots").innerHTML = Array.from({ length: n }, (_, i) => `<i class="${i < paid ? "p" : "f"}"></i>`).join("");
      input.style.setProperty("--pct", `${((v - cur.min) / (cur.max - cur.min || 1)) * 100}%`);
    };
    box.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => {
      cur = tabs.find((x) => x.id === b.dataset.tab) ?? tabs[0];
      box.querySelectorAll("[data-tab]").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      input.min = String(cur.min); input.max = String(cur.max); input.value = String(cur.value);
      render();
    }));
    input.addEventListener("input", render);
    render();
  }
</script>

<style>
  /* ── 1. Hero ── */
  .hero { display: grid; grid-template-columns: 768fr 520fr; gap: 24px; }
  .hero-main { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; min-height: 640px; padding: 48px; box-sizing: border-box; }
  .decor { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero-text, .hero-actions { position: relative; }
